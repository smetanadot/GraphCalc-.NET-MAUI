<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:DESMOS"  
             x:Class="DESMOS.MainPage"
             Shell.NavBarIsVisible="False">

    <Grid ColumnDefinitions="280, *">
        <!-- Левая панель (Sidebar): добавили строки для ползунков -->
        <Grid Grid.Column="0" RowDefinitions="Auto, *, Auto, *" Padding="10" BackgroundColor="#F0F0F0" RowSpacing="10">
            <!-- Заголовок и кнопка добавления новой функции -->
            <HorizontalStackLayout Grid.Row="0" Spacing="10">
                <Label Text="Функции:" FontAttributes="Bold" TextColor="Black" VerticalOptions="Center" />
                <Button Text="+ Добавить" Clicked="OnAddFunctionClicked" Padding="10,4" FontSize="12" />
            </HorizontalStackLayout>

            <!-- Динамический список всех функций -->
            <CollectionView Grid.Row="1" x:Name="FunctionsList">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="local:GraphFunction">
                        <Grid ColumnDefinitions="30, *, 30" ColumnSpacing="6" Margin="0,0,0,8">

                            <!-- Цветной кружок (нажатие меняет цвет линии) -->
                            <Button Grid.Column="0"
                                    BackgroundColor="{Binding LineColor}"
                                    CornerRadius="14"
                                    WidthRequest="28"
                                    HeightRequest="28"
                                    Padding="0"
                                    Clicked="OnColorClicked"
                                    CommandParameter="{Binding .}" />

                            <!-- Поле ввода формулы -->
                            <Entry Grid.Column="1"
                                   Text="{Binding Formula}"
                                   Placeholder="Например: Sin(x)"
                                   TextChanged="OnFormulaTextChanged"
                                   TextColor="Black"
                                   BackgroundColor="White" />

                            <!-- Кнопка удаления строки -->
                            <Button Grid.Column="2"
                                    Text="✕"
                                    TextColor="Gray"
                                    BackgroundColor="Transparent"
                                    Padding="0"
                                    Clicked="OnRemoveFunctionClicked"
                                    CommandParameter="{Binding .}" />
                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <!-- Заголовок блока ползунков -->
            <Label Grid.Row="2" 
                   Text="Параметры:" 
                   FontAttributes="Bold" 
                   TextColor="Black" />

            <!-- Список ползунков для букв a, b, c... -->
            <CollectionView Grid.Row="3" x:Name="ParametersList" MaximumHeightRequest="240">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="local:GraphParameter">
                        <VerticalStackLayout BackgroundColor="White" Padding="8,5" Margin="0,0,0,6" Spacing="2">
                            <HorizontalStackLayout Spacing="5">
                                <Label Text="{Binding Name}" FontAttributes="Bold" TextColor="Black" />
                                <Label Text="=" TextColor="Gray" />
                                <Label Text="{Binding Value, StringFormat='{0:0.##}'}" TextColor="Blue" FontAttributes="Bold" />
                            </HorizontalStackLayout>
                            <Slider Minimum="{Binding Min}"
                                    Maximum="{Binding Max}"
                                    Value="{Binding Value}"
                                    ValueChanged="OnParameterSliderChanged" />
                        </VerticalStackLayout>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </Grid>

        <!-- Правая часть (Холст) -->
        <GraphicsView Grid.Column="1" 
              x:Name="GraphView" 
              SizeChanged="OnGraphViewSizeChanged"
              HandlerChanged="OnGraphViewHandlerChanged">
            <GraphicsView.GestureRecognizers>
                <!--<TapGestureRecognizer Tapped="TapGestureRecognizer_Tapped" />-->
                <PanGestureRecognizer PanUpdated="OnPanUpdated" />
                <PinchGestureRecognizer PinchUpdated="OnPinchUpdated" />
            </GraphicsView.GestureRecognizers>
        </GraphicsView>

        <!-- Кнопки управления масштабом и файлами поверх холста в правом верхнем углу -->
        <HorizontalStackLayout Grid.Column="1"
                               Spacing="10"
                               HorizontalOptions="End"
                               VerticalOptions="Start"
                               Margin="0,15,15,0">
            <Button Text="Увеличить (+)" Clicked="OnZoomInClicked" />
            <Button Text="Уменьшить (-)" Clicked="OnZoomOutClicked" />
            <Button Text="Сохранить" Clicked="OnSaveClicked" Padding="8,4" FontSize="12" />
            <Button Text="Загрузить" Clicked="OnLoadClicked" Padding="8,4" FontSize="12" />
        </HorizontalStackLayout>

        <!-- Всплывающее окно Drag & Drop поверх всего экрана -->
        <Grid x:Name="LoadOverlay"
          Grid.ColumnSpan="2"
          BackgroundColor="#80000000"
          IsVisible="False">

            <Border WidthRequest="420"
                HeightRequest="260"
                BackgroundColor="White"
                Stroke="#3B82F6"
                StrokeThickness="2"
                StrokeDashArray="6,4"
                StrokeShape="RoundRectangle 16"
                HorizontalOptions="Center"
                VerticalOptions="Center"
                Padding="20"
                x:Name="DropZoneBorder"
                HandlerChanged="OnDropZoneHandlerChanged">

                <!-- Распознаватель Drag & Drop -->
                <Border.GestureRecognizers>
                    <DropGestureRecognizer AllowDrop="True"
                                       DragOver="OnFileDragOver"
                                       Drop="OnFileDropped" />
                </Border.GestureRecognizers>

                <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center" Spacing="12">
                    <Label Text="📂" FontSize="42" HorizontalOptions="Center" />
                    <Label Text="Перетащите файл .json сюда"
                       FontSize="18"
                       FontAttributes="Bold"
                       TextColor="Black"
                       HorizontalOptions="Center" />
                    <Label Text="или выберите его через проводник"
                       FontSize="13"
                       TextColor="Gray"
                       HorizontalOptions="Center" />

                    <HorizontalStackLayout Spacing="10" HorizontalOptions="Center" Margin="0,10,0,0">
                        <Button Text="Выбрать файл..." Clicked="OnBrowseFileClicked" />
                        <Button Text="Отмена" BackgroundColor="LightGray" TextColor="Black" Clicked="OnCloseLoadOverlayClicked" />
                    </HorizontalStackLayout>
                </VerticalStackLayout>
            </Border>
        </Grid>

    </Grid>

    

</ContentPage>
